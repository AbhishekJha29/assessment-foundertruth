# Server Port (used locally)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/foundertruth?retryWrites=true&w=majority

# JWT Authentication Secret Key (32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_for_production_auth

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (* for all or your Vercel frontend URL)
CORS_ORIGIN=*
